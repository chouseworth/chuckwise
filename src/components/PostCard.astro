---
import { displayAuthor, formatShortDate, hrefFor, isoDate, isGuest, kickerFor, plainTitle, starString, type PostEntry } from '../lib/posts';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const author = displayAuthor(post);
const guest = isGuest(post);
---

<article class="card">
  <a class="card-link" href={hrefFor(post)}>
    <div class="card-row">
      <span class="card-tags">
        <span class="tag">{kickerFor(post)}</span>
        {guest && <span class="tag ghost">Guest</span>}
      </span>
      {post.data.type === 'review' && post.data.rating != null ? (
        <span class="stars" aria-label={`Rated ${post.data.rating} out of 5`}><span aria-hidden="true">{starString(post.data.rating)}</span></span>
      ) : (
        <time class="read-time" datetime={isoDate(post.data.date)}>{formatShortDate(post.data.date)}</time>
      )}
    </div>
    <h3>{plainTitle(post.data.title)}</h3>
    {post.data.dek && <p>{post.data.dek}</p>}
    <div class="byline">By <b>{author}</b></div>
  </a>
</article>
