---
import { site } from '../lib/site';
import { formatDate, hrefFor, kickerFor, plainTitle, readingMinutes, rotationIndex, type PostEntry } from '../lib/posts';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
const current = rotationIndex(posts.length);
const pad = (n: number) => String(n).padStart(2, '0');
---

{posts.length > 0 && (
  <section class="feature" data-rotator data-epoch={site.rotationEpoch} data-initial={current} aria-roledescription="carousel" aria-label="Featured pieces">
    <div class="wrap">
      <div class="rot">
        <div class="rot-label">In <span>Rotation</span></div>
        <div class="rot-meta" role="group" aria-label="Choose a featured piece">
          {posts.map((post, index) => (
            <button
              type="button"
              data-dot={index}
              class:list={{ on: index === current }}
              aria-pressed={index === current ? 'true' : 'false'}
              aria-label={`Show featured piece ${index + 1} of ${posts.length}: ${plainTitle(post.data.title)}`}
            />
          ))}
          <span class="label" data-count aria-live="polite">{current + 1} / {posts.length}</span>
        </div>
      </div>
      <div>
        {posts.map((post, index) => (
          <div class="rot-copy" data-panel={index} hidden={index !== current}>
            <span class="tag">Featured {kickerFor(post)}</span>
            <h2><a href={hrefFor(post)}>{plainTitle(post.data.title)}</a></h2>
            {post.data.dek && <p>{post.data.dek}</p>}
            <div class="byline">By <b>{site.author}</b> &nbsp;/&nbsp; {readingMinutes(post.body)} min read</div>
            <a class="read" href={hrefFor(post)}>Read the feature →</a>
          </div>
        ))}
      </div>
      <div>
        {posts.map((post, index) => (
          <div class="feature-art" data-panel={index} hidden={index !== current} aria-hidden="true">
            <div class="a"></div>
            <div class="b"></div>
            <div class="c">
              <span class="label">Feature</span>
              <span class="label hot">Nº {pad(index + 1)}/{pad(posts.length)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const root = document.querySelector('[data-rotator]');
  if (root instanceof HTMLElement) {
    const copies = [...root.querySelectorAll('.rot-copy')];
    const arts = [...root.querySelectorAll('.feature-art')];
    const dots = [...root.querySelectorAll('[data-dot]')];
    const count = root.querySelector('[data-count]');
    const total = dots.length;
    const epoch = root.dataset.epoch || '2026-01-05';

    const show = (index) => {
      if (!total) return;
      const next = ((index % total) + total) % total;
      copies.forEach((el) => {
        el.hidden = Number(el.getAttribute('data-panel')) !== next;
      });
      arts.forEach((el) => {
        el.hidden = Number(el.getAttribute('data-panel')) !== next;
      });
      dots.forEach((dot, dotIndex) => {
        const on = dotIndex === next;
        dot.classList.toggle('on', on);
        dot.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (count) count.textContent = `${next + 1} / ${total}`;
    };

    const weekIndex = () => {
      const [year, month, day] = epoch.split('-').map(Number);
      const start = Date.UTC(year, month - 1, day);
      const now = new Date();
      const today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
      const weeks = Math.floor((today - start) / 604800000);
      return ((weeks % total) + total) % total;
    };

    show(weekIndex());
    dots.forEach((dot) => {
      dot.addEventListener('click', () => show(Number(dot.getAttribute('data-dot'))));
    });
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      const current = dots.findIndex((dot) => dot.getAttribute('aria-pressed') === 'true');
      event.preventDefault();
      show(current + (event.key === 'ArrowRight' ? 1 : -1));
    });
  }
</script>
