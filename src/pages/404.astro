---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
---

<Base title="Page not found" description={`That page is not on ${site.name}.`}>
  <main class="wrap missing">
    <h1>404</h1>
    <p>This page is not on the site.</p>
    <a class="read" href="/">Back to the front page →</a>
  </main>
</Base>
