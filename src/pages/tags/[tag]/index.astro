---
import Base from '../../../layouts/Base.astro';
import PostStream from '../../../components/PostStream.astro';
import { site } from '../../../lib/site';
import { collectTags, getPublished, postsForTag, slicePage, tagPagePath } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublished();
  return [...collectTags(posts).entries()].map(([slug, tag]) => ({
    params: { tag: slug },
    props: { label: tag.label },
  }));
}

interface Props {
  label: string;
}

const { label } = Astro.props as Props;
const slug = Astro.params.tag ?? '';
const posts = postsForTag(await getPublished(), slug);
const page = slicePage(posts, 1, (n) => tagPagePath(slug, n));
const description = `Pieces tagged “${label}” on ${site.name}.`;
---

<Base title={label} description={description} current="tags" newerHref={page.newerHref} olderHref={page.olderHref}>
  <header class="page-head">
    <h1>{label}</h1>
    <p>Published pieces with this tag, newest first. <a href="/tags/">All tags</a></p>
  </header>
  <PostStream posts={page.items} newerHref={page.newerHref} olderHref={page.olderHref} />
</Base>
