---
import Base from '../layouts/Base.astro';
import { hasAuthorPhoto } from '../lib/photo';
import { site } from '../lib/site';

const description = `${site.name} is ${site.author}'s site of essays, short takes, and reviews. No tracking, no ads.`;
const photo = hasAuthorPhoto();
const host = new URL(site.url).host;
---

<Base title="About" description={description} current="about">
  <header class="page-head">
    <h1>About</h1>
  </header>
  <div class="prose">
    {photo && <img class="about-photo" src="/images/chuck.jpg" alt={site.author} width="96" height="96" />}
    <p>ChuckWise is Chuck Houseworth’s site for commentary — essays, short takes, and reviews — mostly his. It lives at {host}. Pieces go up when they are ready.</p>
    <p>The pieces on the site right now are sample placeholders. They are here so the pages, the type, and the path from a note to a published URL can be seen before the real writing is moved over. They are not reports. They do not quote real people, and they do not cite real sources.</p>
    <p>A piece is a Markdown file, often written in Obsidian. If it is marked as a draft, it stays off the site. Publishing is a static build on Cloudflare Pages. There is no account, no analytics script, and no ad.</p>
    <h2 id="subscribe">Subscribe</h2>
    <p>There is no newsletter and no email list. New pieces show up in the RSS feed. Add it to a reader, or open it in the browser.</p>
    <p><a class="feed" href="/rss.xml">{host}/rss.xml</a></p>
  </div>
</Base>
